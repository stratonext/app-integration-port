# Port credentials: Port app -> Settings -> Credentials
OCEAN__PORT__CLIENT_ID=
OCEAN__PORT__CLIENT_SECRET=
OCEAN__PORT__BASE_URL=https://api.port.io

OCEAN__INTEGRATION__IDENTIFIER=stratonext

OCEAN__INTEGRATION__CONFIG__STRATONEXT_API_URL=https://api.prod.stratonext.com/v1/graphql
# No workspace setting: one container syncs every workspace the app identity can see.

# --- Continuous mode (run_server.py) ---
# POLLING is the listener that keeps the process up: it serves the /integration/tasks/*
# routes and resyncs every kind periodically. ONCE (run_once.py) and ACTIONS_ONLY
# (run_actions.py) don't resync.
OCEAN__EVENT_LISTENER__TYPE=POLLING
# Minutes between full resyncs of every kind. Unset, Ocean resyncs once at startup and
# never again, so run_server.py fills in 60. run_once.py/run_actions.py ignore it.
OCEAN__SCHEDULED_RESYNC_INTERVAL=60

# --- StratoNext app identity: Admin -> Apps -> Port, credential shown once ---
# Required by every entrypoint. client-credentials grant; the token is fetched
# and refreshed automatically. Declared in .port/spec.json, so Port's install form
# collects the same three values when the integration is installed from the catalog.
OCEAN__INTEGRATION__CONFIG__STRATONEXT_AUTH_TOKEN_URL=https://api.prod.stratonext.com/oauth2/agent-token
OCEAN__INTEGRATION__CONFIG__STRATONEXT_AUTH_CLIENT_ID=
OCEAN__INTEGRATION__CONFIG__STRATONEXT_AUTH_CLIENT_SECRET=

# Shared secret you choose yourself (e.g. openssl rand -hex 32) and paste into Port as
# STRATONEXT_WEBHOOK_SECRET. Port's workflow WEBHOOK nodes send it as X-StratoNext-Secret. Only the
# /integration/tasks/* webhook fallback uses it; native actions do not. Unset, those
# endpoints refuse every request.
OCEAN__INTEGRATION__CONFIG__PORT_WEBHOOK_SECRET=
